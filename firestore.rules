rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwnerUser() {
      return request.auth != null
        && request.auth.token.email.lower() == 'pierre2006hany@gmail.com';
    }

    // Daily questions: any signed-in user reads, only the owner writes.
    match /quizzes/{day} {
      allow read: if request.auth != null;
      allow write: if isOwnerUser();
    }

    match /users/{uid} {

      // Owner email (lowercase). Must match OWNER_EMAIL in app.js.
      function isOwner() {
        return request.auth != null
          && request.auth.token.email.lower() == 'pierre2006hany@gmail.com';
      }

      // Progress saved before this update (works for older accounts too)
      function oldDay()   { return resource.data.get('pDay', ''); }
      function oldCount() { return resource.data.get('pCount', 0); }
      function oldScore() { return resource.data.get('pScore', 0); }

      // A child reads only their own account. The owner reads all.
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());

      // A child creates only their own account, starting at 0 Ambosh.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.ambosh == 0
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.pDay == ''
        && request.resource.data.pCount == 0
        && request.resource.data.pScore == 0;

      // Every answer is saved on its own: one more answer, 0 or 1 Ambosh.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.pDay is string
        && request.resource.data.pCount is int
        && request.resource.data.pScore is int
        && request.resource.data.pCount >= 1
        && request.resource.data.pCount <= 3
        && request.resource.data.pScore >= 0
        && request.resource.data.pScore <= request.resource.data.pCount
        && (
          // continuing the same day's quiz: exactly one more answer
          (request.resource.data.pDay == oldDay()
            && request.resource.data.pCount == oldCount() + 1
            && request.resource.data.pScore >= oldScore()
            && request.resource.data.pScore <= oldScore() + 1
            && request.resource.data.ambosh == resource.data.ambosh + (request.resource.data.pScore - oldScore()))
          ||
          // first answer of a new day (day must be later than the last one)
          (request.resource.data.pDay > oldDay()
            && request.resource.data.pCount == 1
            && request.resource.data.pScore <= 1
            && request.resource.data.ambosh == resource.data.ambosh + request.resource.data.pScore)
        );

      allow delete: if false;
    }
  }
}
